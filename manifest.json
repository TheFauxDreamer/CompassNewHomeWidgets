{
  "manifest_version": 3,
  "name": "Compass Homepage Widgets",
  "version": "1.11.0",
  "description": "Useful live widgets for the Compass homepage: attendance snapshot, unmarked rolls, relief classes, WA weather and calendar event dots, plus an attendance panel from the toolbar.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://reg.bom.gov.au/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Attendance snapshot",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.compass.education/*"
      ],
      "js": [
        "years.js",
        "attendance.js",
        "ui.js",
        "unmarked.js",
        "movements.js",
        "chronicle.js",
        "relief.js",
        "weather.js",
        "homepage.js",
        "calendar-dots.js"
      ],
      "run_at": "document_idle"
    }
  ]
}